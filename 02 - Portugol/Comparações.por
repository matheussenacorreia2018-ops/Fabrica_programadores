programa {
  funcao inicio() {
    inteiro a,b

    escreva("Digite o primeiro valor: ")
    leia(a)
    escreva("Digite o segundo valor: ")
    leia(b)

    escreva("---comparações---\n")
    escreva(" a > b = ",(a>b),"\n")
    escreva("a >= b = ",(a>=b),"\n")
    escreva("a < b = ",(a<b),"\n")
    escreva("a <= b = ",(a<=b),"\n")
    escreva("a != b = ",(a!=b),"\n")
    escreva("a == b = ",(a==b+3),"\n")
    escreva("a <= b = ",(a<=b-5),"\n")
  }
}
